# Copy this to .env and fill in values
# To generate FIREBASE_CREDENTIALS (PowerShell):
#   $bytes = [System.IO.File]::ReadAllBytes("path\to\serviceAccountKey.json")
#   [System.Convert]::ToBase64String($bytes) | Set-Clipboard
FIREBASE_CREDENTIALS=<paste-base64-encoded-service-account-json-here>
PORT=8000
